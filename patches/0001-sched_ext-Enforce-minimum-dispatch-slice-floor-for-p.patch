From 62ee7edd615d9c061de68cb8a0897b5e0da01985 Mon Sep 17 00:00:00 2001
From: rootagi <rootagi@duck.com>
Date: Sun, 15 Nov 2026 16:57:01 +0530
Subject: [PATCH 1/2] sched_ext: Enforce minimum dispatch slice floor for
 protected security tasks

The extensible scheduler class (sched_ext) allows custom BPF struct_ops
schedulers to assign arbitrary execution slices via scx_bpf_dispatch().
While the sched_ext infrastructure provides a timeout watchdog (default
5000ms) to detect total task starvation, an adversarial scheduler can
bypass this watchdog entirely by allocating microsecond-scale time slices
(e.g., 50us to 500us) or selectively skipping dispatch cycles.

Under this adversarial scheduling pattern, security monitoring daemons
(such as EDR agents and audit collectors) are starved below their ingestion
rate while still executing frequently enough to satisfy the 5-second
watchdog, causing kernel ring buffers to overflow and drop telemetry
silently.

This patch introduces a minimum slice floor in scx_bpf_dispatch() and
scx_bpf_dispatch_vtime(). For tasks possessing CAP_SYS_PTRACE, the allocated
slice is clamped to at least SCX_SLICE_DFL:

    if (unlikely(scx_task_is_protected(p))) {
        if (slice < SCX_SLICE_DFL)
            slice = SCX_SLICE_DFL;
    }

This guarantees that protected security tasks receive sufficient quantum
to process buffered kernel telemetry before preemption.

Signed-off-by: rootagi <rootagi@duck.com>
---
 kernel/sched/ext.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/kernel/sched/ext.c b/kernel/sched/ext.c
index 751d73d..b138657 100644
--- a/kernel/sched/ext.c
+++ b/kernel/sched/ext.c
@@ -6026,12 +6026,30 @@ __bpf_kfunc_start_defs();
  * %SCX_SLICE_INF, @p never expires and the BPF scheduler must kick the CPU with
  * scx_bpf_kick_cpu() to trigger scheduling.
  */
+static bool scx_task_is_protected(struct task_struct *p)
+{
+	/* Security daemons and tracer tasks holding CAP_SYS_PTRACE */
+	if (has_capability_noaudit(p, CAP_SYS_PTRACE))
+		return true;
+
+	return false;
+}
+
 __bpf_kfunc void scx_bpf_dispatch(struct task_struct *p, u64 dsq_id, u64 slice,
 				  u64 enq_flags)
 {
 	if (!scx_dispatch_preamble(p, enq_flags))
 		return;
 
+	/*
+	 * Starvation mitigation: clamp slice to minimum granularity floor
+	 * for protected monitoring and security tasks to prevent ringbuffer drop attacks.
+	 */
+	if (unlikely(scx_task_is_protected(p))) {
+		if (slice < SCX_SLICE_DFL)
+			slice = SCX_SLICE_DFL;
+	}
+
 	if (slice)
 		p->scx.slice = slice;
 	else
@@ -6063,6 +6081,15 @@ __bpf_kfunc void scx_bpf_dispatch_vtime(struct task_struct *p, u64 dsq_id,
 	if (!scx_dispatch_preamble(p, enq_flags))
 		return;
 
+	/*
+	 * Starvation mitigation: clamp slice to minimum granularity floor
+	 * for protected monitoring and security tasks to prevent ringbuffer drop attacks.
+	 */
+	if (unlikely(scx_task_is_protected(p))) {
+		if (slice < SCX_SLICE_DFL)
+			slice = SCX_SLICE_DFL;
+	}
+
 	if (slice)
 		p->scx.slice = slice;
 	else
